# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Downloaded content and temporary download files
*.mp4
*.mkv
*.avi
*.part

# Temporary segment files
*_segments/

# Cookie files for authenticated downloads
*_cookies.txt

# Progress metadata files
*_progress.json

# Environment configuration
.env
.env.local
.env.*.local
# Anchored to the repository root: an unanchored negation also re-includes a
# copy of the template nested anywhere else, such as inside a worktree, which
# then rides along in a build made with the builder's default file selection.
!/.env.example

# Temp backup files
old_downloader_tmp.txt

# Audit tooling scripts and outputs (not part of application codebase)
.temp/
.ai/builders/

# User data: the URL list a user passes to `vkdownloader batch`. It holds the
# user's own video links, so it must stay out of version control and out of the
# published artefacts.
urls.txt

# Agent worktrees: each holds a complete second copy of src/vkdownloader/.
.kilo/worktrees/

# Vendored Node dependency tree installed for the agent tooling. Ignored here
# as well as in .kilo/.gitignore because the build backend reads this file, not
# the nested one, when it selects the files to package.
.kilo/node_modules/

# Root debris from earlier tool runs. None of it is part of the project; every
# entry below was left behind by a previous tool run and is listed here so the
# reason is recorded and so the files cannot come back once they are removed
# from the index. Only `stage_and_commit.bat` was tracked in git; it has been
# removed from the index with `git rm --cached`. The remaining rules are
# preventive and the patterns are kept here to document the debris and block
# accidental re-introduction.
# empty file left by an unexpanded %PYFILE% variable
%PYFILE%

# PowerShell pipeline fragment: `Continue` with no argument
Continue

# PowerShell pipeline fragment
Continue=SilentlyContinue

# PowerShell pipeline fragment
ErrorPreference=SilentlyContinue

# captured ruff output
cli_ruff_output.txt

# captured test output
temp_tests_output.txt

# one-off staging script; previously tracked, now removed from the index
stage_and_commit.bat

# empty directory left behind by a stray shell command
Shows/
